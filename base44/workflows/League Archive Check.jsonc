{
  "name": "League Archive Check",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "league_archive_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "archive_leagues": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "archiveCompletedLeagues",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Archive finished leagues",
            "description": "All fixtures played"
          }
        }
      }
    ]
  },
  "description": "Automatically moves leagues to the archive when every fixture has been played",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
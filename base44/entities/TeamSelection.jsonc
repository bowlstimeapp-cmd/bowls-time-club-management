{
  "name": "TeamSelection",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the club"
    },
    "competition": {
      "type": "string",
      "enum": [
        "Bramley",
        "Wessex League",
        "Denny",
        "Top Club",
        "Top Club (Outdoor)",
        "Fantastic 5s",
        "Friendly"
      ],
      "description": "Competition type"
    },
    "match_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the match"
    },
    "match_name": {
      "type": "string",
      "description": "Optional name/description for this match"
    },
    "opponent": {
      "type": "string",
      "description": "Opponent club or team name (populated from fixture or picked from the club list)"
    },
    "selections": {
      "type": "object",
      "description": "JSON object mapping positions to member emails"
    },
    "selection_names": {
      "type": "object",
      "default": {},
      "description": "JSON object mapping positions to the selected member's display name at time of selection (disambiguates members who share an email address)"
    },
    "selected_rinks": {
      "type": "array",
      "description": "Array of rink numbers selected for this match"
    },
    "home_rinks": {
      "type": "number",
      "default": 2,
      "description": "Number of home rinks for this match"
    },
    "match_start_time": {
      "type": "string",
      "description": "Match start time (HH:MM)"
    },
    "match_end_time": {
      "type": "string",
      "description": "Match end time (HH:MM)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft",
      "description": "Whether the selection is visible to members"
    },
    "selector_email": {
      "type": "string",
      "description": "Email of the selector who created this"
    },
    "home_captain_email": {
      "type": "string",
      "description": "Email of the home team captain (optional)"
    },
    "away_captain_email": {
      "type": "string",
      "description": "Email of the away team captain (optional)"
    },
    "friendly_location": {
      "type": "string",
      "description": "Home/Away venue for Friendly and Fantastic 5s matches"
    },
    "friendly_num_rinks": {
      "type": "number",
      "description": "Number of rinks for Friendly matches"
    },
    "friendly_players_per_rink": {
      "type": "number",
      "description": "Players per rink for Friendly matches"
    },
    "prediction_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this match is included in Score Prediction"
    },
    "prediction_reopen_until": {
      "type": "string",
      "description": "ISO timestamp until which predictions are temporarily reopened by an admin"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this selection has been archived (match date has passed)"
    },
    "rinks_booked": {
      "type": "boolean",
      "default": false,
      "description": "Whether rinks have been booked for this selection via the Fixtures module"
    },
    "show_rinks_on_scorecards": {
      "type": "boolean",
      "default": true,
      "description": "Whether booked rink numbers are printed on scorecards generated from this selection"
    },
    "pick_reserves": {
      "type": "boolean",
      "default": false,
      "description": "Whether reserves are picked for this selection"
    },
    "reserves_mode": {
      "type": "string",
      "enum": [
        "squad",
        "named"
      ],
      "default": "squad",
      "description": "Squad mode shows 'Reserves from squad'; named mode lists up to 5 named reserves"
    },
    "reserves": {
      "type": "array",
      "default": [],
      "maxItems": 5,
      "description": "Named reserves (max 5) \u2014 NOT players; ignored by scorecards, live scoring, predictions, Elo and accolades",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "number",
            "description": "Reserve slot number 1-5"
          },
          "email": {
            "type": "string",
            "description": "Reserve member email"
          },
          "type": {
            "type": "string",
            "enum": [
              "home",
              "away"
            ],
            "description": "Whether this is a home or away reserve"
          }
        }
      }
    },
    "show_venue_address": {
      "type": "boolean",
      "default": false,
      "description": "Whether the venue address is shown on SelectionView and printed team sheets"
    },
    "venue_location": {
      "type": "string",
      "enum": [
        "home",
        "away"
      ],
      "default": "home",
      "description": "Which venue the address refers to"
    },
    "venue_address": {
      "type": "string",
      "description": "Snapshot of the venue address, shown on SelectionView and team sheets"
    }
  },
  "required": [
    "club_id",
    "competition",
    "match_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
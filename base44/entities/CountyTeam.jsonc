{
  "name": "CountyTeam",
  "type": "object",
  "properties": {
    "county_id": {
      "type": "string",
      "description": "Reference to the county"
    },
    "name": {
      "type": "string",
      "description": "Team name"
    },
    "team_type": {
      "type": "string",
      "enum": [
        "club",
        "representative"
      ],
      "description": "club = reports a roster from the club's own membership; representative = selected from CountyMembership"
    },
    "club_id": {
      "type": "string",
      "description": "Required when team_type is 'club' \u2014 must reference an approved ClubCountyAffiliation for this county. Null for representative teams."
    }
  },
  "required": [
    "county_id",
    "name",
    "team_type"
  ],
  "rls": {
    "read": {},
    "create": false,
    "update": false,
    "delete": false
  }
}
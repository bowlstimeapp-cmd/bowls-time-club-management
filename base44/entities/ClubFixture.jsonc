{
  "name": "ClubFixture",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the club"
    },
    "competition_id": {
      "type": "string",
      "description": "Reference to the Competition entity"
    },
    "gender": {
      "type": "string",
      "enum": [
        "mixed",
        "men",
        "women"
      ],
      "default": "mixed",
      "description": "Which players this fixture is open to. men = male members only, women = female members only, mixed = all members. Controls both who can sign up and who appears in the team selection dropdowns"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fixture date"
    },
    "time": {
      "type": "string",
      "description": "Match start time (HH:MM)"
    },
    "finish_time": {
      "type": "string",
      "description": "Match finish time (HH:MM). If set, rink booking creates sessions between time and finish_time."
    },
    "opponent": {
      "type": "string",
      "description": "Opponent club or team name"
    },
    "venue": {
      "type": "string",
      "enum": [
        "Home",
        "Away",
        "Home & Away"
      ],
      "description": "Fixture venue"
    },
    "notes": {
      "type": "string",
      "description": "Optional fixture notes"
    },
    "broadcast": {
      "type": "boolean",
      "default": false,
      "description": "When true the fixture is open for member sign-up and appears on the Member Dashboard. Only club admins can change this."
    }
  },
  "required": [
    "club_id",
    "competition_id",
    "date",
    "time",
    "venue"
  ],
  "rls": {
    "read": {},
    "create": false,
    "update": false,
    "delete": false
  }
}
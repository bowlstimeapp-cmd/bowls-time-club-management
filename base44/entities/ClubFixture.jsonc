{
  "name": "ClubFixture",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the club"
    },
    "competition_id": {
      "type": "string",
      "description": "Reference to the Competition entity"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fixture date"
    },
    "time": {
      "type": "string",
      "description": "Match start time (HH:MM)"
    },
    "finish_time": {
      "type": "string",
      "description": "Match finish time (HH:MM). If set, rink booking creates sessions between time and finish_time."
    },
    "opponent": {
      "type": "string",
      "description": "Opponent club or team name"
    },
    "venue": {
      "type": "string",
      "enum": [
        "Home",
        "Away",
        "Home & Away"
      ],
      "description": "Fixture venue"
    },
    "notes": {
      "type": "string",
      "description": "Optional fixture notes"
    }
  },
  "required": [
    "club_id",
    "competition_id",
    "date",
    "time",
    "venue"
  ],
  "rls": {
    "read": {},
    "create": false,
    "update": false,
    "delete": false
  }
}
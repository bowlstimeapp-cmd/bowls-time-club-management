{
  "name": "FunctionRoom",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the club"
    },
    "name": {
      "type": "string",
      "description": "Room name (e.g. Main Hall, Committee Room)"
    },
    "description": {
      "type": "string",
      "description": "Description of the room"
    },
    "capacity": {
      "type": "number",
      "description": "Maximum capacity"
    },
    "price_per_hour": {
      "type": "number",
      "description": "Hire price per hour in pence (e.g. 1000 = \u00a310)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this room is available to book"
    },
    "auto_approve": {
      "type": "boolean",
      "default": false,
      "description": "Automatically approve booking requests without admin sign-off"
    },
    "available_from": {
      "type": "string",
      "description": "Earliest available time each day (HH:MM)"
    },
    "available_to": {
      "type": "string",
      "description": "Latest available time each day (HH:MM)"
    }
  },
  "required": [
    "club_id",
    "name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    }
  }
}
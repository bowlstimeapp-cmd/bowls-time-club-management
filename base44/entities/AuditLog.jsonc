{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the club"
    },
    "action": {
      "type": "string",
      "description": "Type of action performed"
    },
    "target_email": {
      "type": "string",
      "description": "Email of the user affected"
    },
    "target_name": {
      "type": "string",
      "description": "Name of the user affected"
    },
    "performed_by_email": {
      "type": "string",
      "description": "Email of the admin who performed the action"
    },
    "performed_by_name": {
      "type": "string",
      "description": "Name of the admin who performed the action"
    },
    "old_value": {
      "type": "string",
      "description": "Previous value"
    },
    "new_value": {
      "type": "string",
      "description": "New value"
    },
    "details": {
      "type": "string",
      "description": "Additional details about the action"
    }
  },
  "required": [
    "club_id",
    "action",
    "performed_by_email"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}
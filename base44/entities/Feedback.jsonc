{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user submitting feedback"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the user submitting feedback"
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "feature",
        "improvement",
        "other",
        "paid_enquiry"
      ],
      "default": "feature",
      "description": "Type of feedback"
    },
    "title": {
      "type": "string",
      "description": "Feedback title"
    },
    "description": {
      "type": "string",
      "description": "Detailed feedback description"
    },
    "status": {
      "type": "string",
      "enum": [
        "new_feedback",
        "reviewed",
        "implemented",
        "abandoned"
      ],
      "default": "new_feedback",
      "description": "Status of the feedback"
    },
    "admin_response": {
      "type": "string",
      "description": "Legacy single admin response. Kept for old records only; new replies live in FeedbackMessage"
    },
    "related_club_id": {
      "type": "string",
      "description": "The club a paid enquiry originated from"
    },
    "related_module": {
      "type": "string",
      "description": "Which locked module triggered the enquiry (e.g. module_leagues)"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the most recent message in the thread was posted"
    },
    "last_message_by": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "description": "Who posted the most recent message"
    },
    "unread_by_user": {
      "type": "boolean",
      "default": false,
      "description": "True when an admin has replied and the user has not opened the thread"
    },
    "unread_by_admin": {
      "type": "boolean",
      "default": false,
      "description": "True when the user has replied and the admin has not opened the thread"
    },
    "conversation_closed": {
      "type": "boolean",
      "default": false,
      "description": "When true the user can no longer reply, but admins can"
    },
    "last_admin_email_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the admin inbox was last emailed about a user reply on this thread (throttled to once per 30 minutes)"
    }
  },
  "required": [
    "user_email",
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
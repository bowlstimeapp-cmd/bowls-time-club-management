{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "User role"
    },
    "title": {
      "type": "string",
      "description": "User's title (Mr, Mrs, Miss, Ms, Dr, Prof)"
    },
    "known_as": {
      "type": "string",
      "description": "Preferred name or nickname"
    },
    "first_name": {
      "type": "string",
      "description": "User's first name"
    },
    "surname": {
      "type": "string",
      "description": "User's surname"
    },
    "phone": {
      "type": "string",
      "description": "User's phone number"
    },
    "dismissed_help_popups": {
      "type": "array",
      "default": [],
      "description": "Page names whose context-sensitive help pop-up the user has permanently dismissed",
      "items": {
        "type": "string"
      }
    },
    "help_popups_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether context-sensitive help pop-ups are shown on admin pages"
    }
  },
  "required": [
    "title",
    "known_as",
    "first_name",
    "surname",
    "phone"
  ]
}
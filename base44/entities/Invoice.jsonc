{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the club this invoice belongs to"
    },
    "invoice_number": {
      "type": "string",
      "description": "Display Invoice ID (INV-0001 incremental)"
    },
    "amount": {
      "type": "number",
      "description": "Invoice total amount in pounds (member_count x rate)"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the billing period"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "End of the billing period"
    },
    "date_issued": {
      "type": "string",
      "format": "date",
      "description": "Date the invoice was issued (invoice date)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Date payment is due (date_issued + 20 days)"
    },
    "payment_terms": {
      "type": "string",
      "default": "20 days",
      "description": "Payment terms"
    },
    "member_count": {
      "type": "number",
      "description": "Number of active members in the club when invoiced"
    },
    "rate": {
      "type": "number",
      "default": 2,
      "description": "Rate per member in pounds"
    },
    "description": {
      "type": "string",
      "default": "Bowls Time Subscription",
      "description": "Line item description"
    },
    "client_name": {
      "type": "string",
      "description": "Client company name (club name)"
    },
    "status": {
      "type": "string",
      "default": "issued",
      "description": "Invoice payment status (free text)"
    },
    "is_test": {
      "type": "boolean",
      "default": false,
      "description": "True for invoices created via the manual test-generation button"
    }
  },
  "required": [
    "club_id",
    "invoice_number",
    "amount",
    "period_start",
    "period_end",
    "date_issued"
  ],
  "rls": {
    "create": false,
    "update": false,
    "delete": false
  }
}
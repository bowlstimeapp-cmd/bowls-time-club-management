{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the club this invoice belongs to"
    },
    "invoice_number": {
      "type": "string",
      "description": "Display Invoice ID"
    },
    "amount": {
      "type": "number",
      "description": "Invoice amount in pounds (2 decimal places, e.g. 45.67)"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the billing period"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "End of the billing period"
    },
    "date_issued": {
      "type": "string",
      "format": "date",
      "description": "Date the invoice was issued"
    },
    "status": {
      "type": "string",
      "default": "issued",
      "description": "Invoice payment status (free text \u2014 platform admins can set any value)"
    },
    "is_test": {
      "type": "boolean",
      "default": false,
      "description": "True for invoices created via the manual test-generation button; false for real monthly invoices"
    }
  },
  "required": [
    "club_id",
    "invoice_number",
    "amount",
    "period_start",
    "period_end",
    "date_issued"
  ],
  "rls": {
    "create": false,
    "update": false,
    "delete": false
  }
}
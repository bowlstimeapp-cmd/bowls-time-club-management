{
  "name": "MemberAvailability",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the club"
    },
    "selection_id": {
      "type": "string",
      "description": "Reference to the team selection"
    },
    "user_email": {
      "type": "string",
      "description": "User's email"
    },
    "is_available": {
      "type": "boolean",
      "description": "Whether the member is available"
    }
  },
  "required": [
    "club_id",
    "selection_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}
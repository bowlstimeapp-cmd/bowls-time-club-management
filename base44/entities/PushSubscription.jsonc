{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the subscribed user"
    },
    "endpoint": {
      "type": "string",
      "description": "Push subscription endpoint URL"
    },
    "p256dh": {
      "type": "string",
      "description": "Client public key (base64url)"
    },
    "auth": {
      "type": "string",
      "description": "Client auth secret (base64url)"
    }
  },
  "required": [
    "user_email",
    "endpoint"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}
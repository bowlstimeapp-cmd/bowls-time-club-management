{
  "name": "ProspectClub",
  "type": "object",
  "properties": {
    "club_name": {
      "type": "string",
      "description": "Name of the prospect club"
    },
    "address": {
      "type": "string",
      "description": "Club address"
    },
    "town": {
      "type": "string",
      "description": "Town or city"
    },
    "county": {
      "type": "string",
      "description": "County or region"
    },
    "postcode": {
      "type": "string",
      "description": "Postcode"
    },
    "email": {
      "type": "string",
      "description": "Main contact email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "website": {
      "type": "string",
      "description": "Club website URL"
    },
    "play_bowls_url": {
      "type": "string",
      "description": "Play Bowls directory URL"
    },
    "contact_name": {
      "type": "string",
      "description": "Name of the contact person"
    },
    "primary_email": {
      "type": "string",
      "description": "Primary email address"
    },
    "where_to_find_us_email": {
      "type": "string",
      "description": "Where to Find Us email"
    },
    "website_email": {
      "type": "string",
      "description": "Email found on the club website"
    },
    "directory_email": {
      "type": "string",
      "description": "Email from directory listing"
    },
    "directory_source_url": {
      "type": "string",
      "description": "URL of the directory source"
    },
    "final_recommended_email": {
      "type": "string",
      "description": "Final recommended email to use for outreach"
    },
    "confidence": {
      "type": "string",
      "description": "Lead confidence level (e.g. High, Medium, Low)"
    },
    "validation_status": {
      "type": "string",
      "description": "Email validation status"
    },
    "validation_notes": {
      "type": "string",
      "description": "Notes from email validation"
    },
    "data_source": {
      "type": "string",
      "description": "Source of the data (e.g. play-bowls.com, manual, scraper)"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "Date the prospect data was last updated"
    },
    "last_validated": {
      "type": "string",
      "format": "date",
      "description": "Date the email was last validated"
    },
    "source": {
      "type": "string",
      "description": "Where this lead came from",
      "default": "play-bowls.com"
    },
    "contact_status": {
      "type": "string",
      "enum": [
        "not_contacted",
        "contacted",
        "email_sent",
        "follow_up",
        "not_interested",
        "interested",
        "signed_up"
      ],
      "default": "not_contacted",
      "description": "Status of outreach"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this club"
    },
    "last_contacted_date": {
      "type": "string",
      "format": "date",
      "description": "Date last contacted"
    }
  },
  "required": [
    "club_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}
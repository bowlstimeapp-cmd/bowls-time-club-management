{
  "name": "ScorecardLayout",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the club"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this layout is currently active for the club"
    },
    "layout_config": {
      "type": "object",
      "description": "Layout configuration with an 'elements' array, each element having id, type, x, y, width, height, styles"
    }
  },
  "required": [
    "club_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    }
  }
}